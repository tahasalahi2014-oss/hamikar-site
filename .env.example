# Copy to .env locally. Never commit real credentials.
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hamikar?schema=public"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
CORS_ORIGIN="http://localhost:8080"
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=20
# Configure only after selecting providers:
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
SMS_PROVIDER=
SMS_API_KEY=
